# ==============================================================================
# MINEGUARD FRONTEND PRODUCTION CONFIGURATION (VERCEL)
# ==============================================================================

# Backend Public API Endpoint (Render / Cloud Host)
# In development, leave empty or set to /api to use the Vite local reverse proxy
# In production, set to your deployed backend URL:
VITE_API_URL=https://your-mineguard-backend.onrender.com/api

# Real-Time WebSocket / Socket.IO Server Endpoint
# Leave blank to automatically inherit the origin from VITE_API_URL
VITE_SOCKET_URL=https://your-mineguard-backend.onrender.com

