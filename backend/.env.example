# ==============================================================================
# MINEGUARD BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Public URLs
FRONTEND_URL=https://your-mineguard-frontend.vercel.app
BACKEND_URL=https://your-mineguard-backend.onrender.com

# Persistent Database (Managed Cloud PostgreSQL)
# Example (Render/Neon/Supabase): postgresql://username:password@ep-host.region.aws.neon.tech/mineguard?sslmode=require
DATABASE_URL=
# Leave DATABASE_URL empty if running with local persistent SQLite (mineguard.db)

# Cloud MQTT Broker Configuration (HiveMQ Cloud / EMQX Cloud / Mosquitto)
# Use mqtts:// for TLS encrypted broker connection (port 8883) or mqtt:// for standard (port 1883)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mineguard_cloud_server_01
MQTT_TOPIC_PREFIX=mineguard/zones

# Heartbeat & Safety Watchdog Configuration
HEARTBEAT_TIMEOUT_SECONDS=15
DEMO_MODE=false
